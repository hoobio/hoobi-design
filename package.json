{
  "name": "hoobi-design-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -C react run build",
    "typecheck": "pnpm -C react run typecheck",
    "test": "pnpm -C react test",
    "tokens": "node tokens/build.mjs",
    "fonts:fetch": "pnpm -C react run fonts:fetch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
