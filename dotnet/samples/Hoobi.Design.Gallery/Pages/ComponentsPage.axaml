<UserControl
    x:Class="Hoobi.Design.Gallery.ComponentsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hoobi="using:Hoobi.Design.Avalonia">
    <ScrollViewer>
        <StackPanel x:Name="Body" Margin="{StaticResource HoobiPageGutter}" Spacing="8">
            <TextBlock Text="Components" FontFamily="{StaticResource HoobiDisplayFontFamily}" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource HoobiPageTitleMargin}" />
            <TextBlock Classes="GroupHeader" Text="LevelMeter (one, two and three bars; hold; Volume 0.6)" />
            <StackPanel Width="320" HorizontalAlignment="Left" Spacing="8">
                <hoobi:LevelMeter x:Name="MonoMeter" Height="6" />
                <hoobi:LevelMeter x:Name="StereoMeter" Height="8" />
                <hoobi:LevelMeter x:Name="SurroundMeter" Height="12" Volume="0.6" />
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="RichTextBlock (RichBlock, RichRun)" />
            <hoobi:RichTextBlock x:Name="Notes" MaxWidth="560" HorizontalAlignment="Left" />
            <TextBlock Classes="GroupHeader" Text="TextHighlight.Start, TextHighlight.Length" />
            <TextBlock Classes="Body" Text="WeakAuras Companion" hoobi:TextHighlight.Start="4" hoobi:TextHighlight.Length="5" />
            <TextBlock Classes="GroupHeader" Text="IconImage.FallbackSource, RemoteImage.MarkFailed" />
            <hoobi:IconImage x:Name="BrokenIcon" Width="32" Height="32" HorizontalAlignment="Left">
                <hoobi:IconImage.FallbackSource>
                    <DrawingImage>
                        <GeometryDrawing Brush="{StaticResource HoobiSurfaceRaisedBrush}" Geometry="M4,0 H28 A4,4 0 0 1 32,4 V28 A4,4 0 0 1 28,32 H4 A4,4 0 0 1 0,28 V4 A4,4 0 0 1 4,0 Z" />
                    </DrawingImage>
                </hoobi:IconImage.FallbackSource>
            </hoobi:IconImage>
            <TextBlock Classes="GroupHeader" Text="Tone: ToneConverters.Brush, ToneConverters.Glyph" />
            <ItemsControl x:Name="Tones">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="hoobi:Tone">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="Icon" Text="{Binding Converter={x:Static hoobi:ToneConverters.Glyph}}" Foreground="{Binding Converter={x:Static hoobi:ToneConverters.Brush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding}" Foreground="{Binding Converter={x:Static hoobi:ToneConverters.Brush}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="GroupHeader" Text="Toned.Tone on Border.Alert, Border.Badge and Button" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="Alert" hoobi:Toned.Tone="Warn">
                    <TextBlock Text="Warn" />
                </Border>
                <Border Classes="Alert" hoobi:Toned.Tone="Danger">
                    <TextBlock Text="Danger" />
                </Border>
                <Border Classes="Alert" hoobi:Toned.Tone="Success">
                    <TextBlock Text="Success" />
                </Border>
                <Border Classes="Alert" hoobi:Toned.Tone="Info">
                    <TextBlock Text="Info" />
                </Border>
                <Border Classes="Badge" hoobi:Toned.Tone="Accent">
                    <TextBlock Text="Accent badge" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Neutral" hoobi:Toned.Tone="Neutral" />
                <Button Content="Accent" hoobi:Toned.Tone="Accent" />
                <Button Content="Warn" hoobi:Toned.Tone="Warn" />
                <Button Content="Danger" hoobi:Toned.Tone="Danger" />
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="ToneConverters.Initials" />
            <TextBlock x:Name="Initials" Classes="BodyStrong" />
            <TextBlock Classes="GroupHeader" Text="ToastWindow.Show with a Tone" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="InfoToastButton" Content="Info toast" />
                <Button x:Name="WarnToastButton" Content="Warn toast" />
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="PageEntrance.PlayAsync" />
            <Button x:Name="ReplayButton" Content="Replay entrance" />
            <TextBlock Classes="GroupHeader" Text="HoverSubmenu.IsEnabled (opens after Motion.SubmenuDelay)" />
            <Button Content="Guild" hoobi:HoverSubmenu.IsEnabled="True">
                <Button.Flyout>
                    <Flyout Placement="RightEdgeAlignedTop">
                        <StackPanel Width="220" Spacing="2">
                            <Button Content="Example Raiders" Theme="{StaticResource MenuRowButtonStyle}" />
                            <Button Content="Night Shift" Theme="{StaticResource MenuRowButtonStyle}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
