<UserControl
    x:Class="Hoobi.Design.Gallery.ButtonsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <Grid Margin="{StaticResource HoobiPageGutter}" ColumnDefinitions="Auto,*">
        <StackPanel Spacing="8">
            <TextBlock Text="Buttons" FontFamily="{StaticResource HoobiDisplayFontFamily}" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource HoobiPageTitleMargin}" />
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="GroupHeader" Text="Theme or class" Margin="0,12,0,0" />
                <TextBlock Grid.Column="1" Classes="GroupHeader" Text="Rest" Margin="0,12,0,0" />
                <TextBlock Grid.Column="2" Classes="GroupHeader" Text="Disabled" Margin="0,12,0,0" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="Button" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Save" />
                <Button Grid.Column="2" Content="Save" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="DefaultButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource DefaultButtonStyle}" Content="Save" />
                <Button Grid.Column="2" Theme="{StaticResource DefaultButtonStyle}" Content="Save" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="AccentButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource AccentButtonStyle}" Content="Install" />
                <Button Grid.Column="2" Theme="{StaticResource AccentButtonStyle}" Content="Install" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="Button.accent" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="accent" Content="Install" />
                <Button Grid.Column="2" Classes="accent" Content="Install" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="CriticalButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource CriticalButtonStyle}" Content="Delete" />
                <Button Grid.Column="2" Theme="{StaticResource CriticalButtonStyle}" Content="Delete" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="CautionButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource CautionButtonStyle}" Content="Restart" />
                <Button Grid.Column="2" Theme="{StaticResource CautionButtonStyle}" Content="Restart" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="SubtleButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource SubtleButtonStyle}" Content="Cancel" />
                <Button Grid.Column="2" Theme="{StaticResource SubtleButtonStyle}" Content="Cancel" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="MenuRowButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource MenuRowButtonStyle}" Content="Open folder" Margin="0,0,16,0" />
                <Button Grid.Column="2" Theme="{StaticResource MenuRowButtonStyle}" Content="Open folder" IsEnabled="False" Margin="0,0,16,0" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="IconButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Edit}" ToolTip.Tip="Edit" />
                <Button Grid.Column="2" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Edit}" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="DangerIconButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource DangerIconButtonStyle}" Content="{StaticResource Glyph.Delete}" ToolTip.Tip="Delete" />
                <Button Grid.Column="2" Theme="{StaticResource DangerIconButtonStyle}" Content="{StaticResource Glyph.Delete}" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="AddRowButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource AddRowButtonStyle}" Content="Add a folder" Margin="0,0,16,0" />
                <Button Grid.Column="2" Theme="{StaticResource AddRowButtonStyle}" Content="Add a folder" IsEnabled="False" Margin="0,0,16,0" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="CaptionLinkButtonStyle" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource CaptionLinkButtonStyle}" Content="Learn more" />
                <Button Grid.Column="2" Theme="{StaticResource CaptionLinkButtonStyle}" Content="Learn more" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="DialogCloseButtonStyle.accent" VerticalAlignment="Center" />
                <Button Grid.Column="1" Theme="{StaticResource DialogCloseButtonStyle}" Classes="accent" Content="Close" />
                <Button Grid.Column="2" Theme="{StaticResource DialogCloseButtonStyle}" Classes="accent" Content="Close" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="HyperlinkButton" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="Release notes" />
                <HyperlinkButton Grid.Column="2" Content="Release notes" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="ToggleButton" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ToggleButton Content="Off" />
                    <ToggleButton Content="On" IsChecked="True" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ToggleButton Content="Off" IsEnabled="False" />
                    <ToggleButton Content="On" IsChecked="True" IsEnabled="False" />
                </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="SplitButton" VerticalAlignment="Center" />
                <SplitButton Grid.Column="1" Content="Update" />
                <SplitButton Grid.Column="2" Content="Update" IsEnabled="False" />
            </Grid>
            <Grid ColumnDefinitions="240,220,220">
                <TextBlock Classes="FieldLabel" Text="DropDownButton" VerticalAlignment="Center" />
                <DropDownButton Grid.Column="1" Content="Sort" />
                <DropDownButton Grid.Column="2" Content="Sort" IsEnabled="False" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="24,48,0,0" Spacing="8">
            <TextBlock Classes="GroupHeader" Text="Button.Tinted, ToggleButton.Tinted" />
            <TextBlock Classes="FieldLabel" Text="Rest, pointerover, pressed" />
            <Grid x:Name="TintedTiles" ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Grid.Styles>
                    <Style Selector="Button.Tinted, ToggleButton.Tinted">
                        <Setter Property="Width" Value="56" />
                        <Setter Property="Height" Value="56" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource HoobiBgBrush}" />
                        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
                        <Setter Property="FontSize" Value="24" />
                    </Style>
                </Grid.Styles>
                <TextBlock Classes="FieldLabel" Text="Danger" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="Tinted" Background="{DynamicResource SystemFillColorCriticalBrush}" Content="{StaticResource Glyph.Dismiss}" />
                <Button Grid.Column="2" Classes="Tinted" Tag=":pointerover" Background="{DynamicResource SystemFillColorCriticalBrush}" Content="{StaticResource Glyph.Dismiss}" />
                <Button Grid.Column="3" Classes="Tinted" Tag=":pointerover :pressed" Background="{DynamicResource SystemFillColorCriticalBrush}" Content="{StaticResource Glyph.Dismiss}" />
                <TextBlock Grid.Row="1" Classes="FieldLabel" Text="Accent" VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="1" Classes="Tinted" Background="{DynamicResource AccentFillColorDefaultBrush}" Content="{StaticResource Glyph.Game}" />
                <Button Grid.Row="1" Grid.Column="2" Classes="Tinted" Tag=":pointerover" Background="{DynamicResource AccentFillColorDefaultBrush}" Content="{StaticResource Glyph.Game}" />
                <Button Grid.Row="1" Grid.Column="3" Classes="Tinted" Tag=":pointerover :pressed" Background="{DynamicResource AccentFillColorDefaultBrush}" Content="{StaticResource Glyph.Game}" />
                <TextBlock Grid.Row="2" Classes="FieldLabel" Text="Hex, toggle" VerticalAlignment="Center" />
                <ToggleButton Grid.Row="2" Grid.Column="1" Classes="Tinted" Background="#FFD4BFFF" Content="{StaticResource Glyph.StarFilled}" />
                <ToggleButton Grid.Row="2" Grid.Column="2" Classes="Tinted" Tag=":pointerover" Background="#FFD4BFFF" Content="{StaticResource Glyph.StarFilled}" />
                <ToggleButton Grid.Row="2" Grid.Column="3" Classes="Tinted" Tag=":pointerover :pressed" Background="#FFD4BFFF" Content="{StaticResource Glyph.StarFilled}" />
            </Grid>
            <TextBlock Classes="GroupHeader" Text="ToggleButton.Disclosure" />
            <TextBlock Classes="FieldLabel" Text="Rest, pointerover, checked, pressed, disabled" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton Classes="Disclosure" Content="More" />
                <ToggleButton Classes="Disclosure" Tag=":pointerover" Content="More" />
                <ToggleButton Classes="Disclosure" IsChecked="True" Content="More" />
                <ToggleButton Classes="Disclosure" Tag=":pointerover :pressed" Content="More" />
                <ToggleButton Classes="Disclosure" IsEnabled="False" IsChecked="True" Content="More" />
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="SubtleButtonStyle.RowOverlay" />
            <TextBlock Classes="FieldLabel" Text="Rest, pointerover, pressed, disabled" />
            <Border Classes="Group" Width="320" HorizontalAlignment="Left">
                <StackPanel Classes="Rows">
                    <Panel>
                        <Border Classes="Row">
                            <TextBlock Text="Vault" />
                        </Border>
                        <Button Theme="{StaticResource SubtleButtonStyle}" Classes="RowOverlay" />
                    </Panel>
                    <Panel>
                        <Border Classes="Row">
                            <TextBlock Text="Vault" />
                        </Border>
                        <Button Theme="{StaticResource SubtleButtonStyle}" Classes="RowOverlay" Tag=":pointerover" />
                    </Panel>
                    <Panel>
                        <Border Classes="Row">
                            <TextBlock Text="Vault" />
                        </Border>
                        <Button Theme="{StaticResource SubtleButtonStyle}" Classes="RowOverlay" Tag=":pointerover :pressed" />
                    </Panel>
                    <Panel>
                        <Border Classes="Row">
                            <TextBlock Text="Vault" />
                        </Border>
                        <Button Theme="{StaticResource SubtleButtonStyle}" Classes="RowOverlay" IsEnabled="False" />
                    </Panel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
