<UserControl
    x:Class="Hoobi.Design.Gallery.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hoobi="using:Hoobi.Design.Avalonia">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource HoobiPageGutter}" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings cards" FontFamily="{StaticResource HoobiDisplayFontFamily}" FontSize="26" FontWeight="SemiBold" Margin="{StaticResource HoobiPageTitleMargin}" />
            <TextBlock Classes="GroupHeader" Text="SettingsCard" />
            <hoobi:SettingsCard Header="Start at sign-in" Description="Opens in the tray when Windows starts." HeaderGlyph="{StaticResource Glyph.PowerButton}">
                <ToggleSwitch IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" />
            </hoobi:SettingsCard>
            <TextBlock Classes="GroupHeader" Text="StackPanel.SettingsGroup, SettingsCard.FirstVisible, SettingsCard.LastVisible, first card at :pointerover" />
            <StackPanel Classes="SettingsGroup">
                <hoobi:SettingsCard Header="Addon folder" Description="D:\Games\World of Warcraft\Interface\AddOns" HeaderGlyph="{StaticResource Glyph.Folder}" IsClickEnabled="True" ActionGlyph="{StaticResource Glyph.ChevronRight}" Tag=":pointerover" />
                <hoobi:SettingsCard Header="Release channel" HeaderGlyph="{StaticResource Glyph.Sync}">
                    <ComboBox SelectedIndex="0" Width="160">
                        <ComboBoxItem Content="Stable" />
                        <ComboBoxItem Content="Pre-release" />
                    </ComboBox>
                </hoobi:SettingsCard>
                <hoobi:SettingsCard Header="Check for updates" Description="Every 30 minutes." HeaderGlyph="{StaticResource Glyph.Refresh}">
                    <ToggleSwitch OnContent="{x:Null}" OffContent="{x:Null}" />
                </hoobi:SettingsCard>
                <hoobi:SettingsCard Header="Sign in to sync" Description="Needs a Store build." HeaderGlyph="{StaticResource Glyph.Lock}" IsEnabled="False" />
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="SettingsCard.Item fold, control in the header, Border.Row.Switch.Child and a nested fold" />
            <StackPanel Classes="Rows">
                <hoobi:SettingsCard Classes="Item" BorderThickness="0" IsClickEnabled="True" IsExpanded="True">
                    <hoobi:SettingsCard.Header>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Region" FontSize="{StaticResource ControlContentThemeFontSize}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="0">
                                <ComboBoxItem Content="Self-hosted" />
                                <ComboBoxItem Content="bitwarden.com" />
                            </ComboBox>
                        </Grid>
                    </hoobi:SettingsCard.Header>
                    <hoobi:SettingsCard.ExpandedContent>
                        <StackPanel Classes="Rows" Margin="0,1,0,0">
                            <Border Classes="Row Switch Child">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Server URL" />
                                    <TextBox PlaceholderText="https://bitwarden.company.com" />
                                </StackPanel>
                            </Border>
                            <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Advanced" IsClickEnabled="True" IsExpanded="False" />
                        </StackPanel>
                    </hoobi:SettingsCard.ExpandedContent>
                </hoobi:SettingsCard>
                <Border Classes="Row Switch">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Unlock with Windows Hello" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" />
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="SettingsCard.Preview in a SettingsCard.PreviewScope, wide and narrow" />
            <StackPanel Classes="Rows">
                <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Show Tags" IsClickEnabled="True" IsExpanded="True">
                    <hoobi:SettingsCard.ExpandedContent>
                        <StackPanel Classes="Rows" Margin="0,1,0,0" hoobi:SettingsCard.PreviewScope="True">
                            <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Watchtower" Description="Tags weak, old or insecure passwords">
                                <hoobi:SettingsCard.Preview>
                                    <Border Classes="Badge"><TextBlock Text="Weak password" /></Border>
                                </hoobi:SettingsCard.Preview>
                                <ToggleSwitch IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </hoobi:SettingsCard>
                            <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Passkey" Description="Tags items that sign in with a passkey">
                                <hoobi:SettingsCard.Preview>
                                    <Border Classes="Badge"><TextBlock Text="Passkey" /></Border>
                                </hoobi:SettingsCard.Preview>
                                <ToggleSwitch IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </hoobi:SettingsCard>
                        </StackPanel>
                    </hoobi:SettingsCard.ExpandedContent>
                </hoobi:SettingsCard>
            </StackPanel>
            <StackPanel Classes="Rows" Width="420" HorizontalAlignment="Left">
                <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Show Tags" IsClickEnabled="True" IsExpanded="True">
                    <hoobi:SettingsCard.ExpandedContent>
                        <StackPanel Classes="Rows" Margin="0,1,0,0" hoobi:SettingsCard.PreviewScope="True">
                            <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Watchtower" Description="Tags weak, old or insecure passwords">
                                <hoobi:SettingsCard.Preview>
                                    <Border Classes="Badge"><TextBlock Text="Weak password" /></Border>
                                </hoobi:SettingsCard.Preview>
                                <ToggleSwitch IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </hoobi:SettingsCard>
                            <hoobi:SettingsCard Classes="Item" BorderThickness="0" Header="Passkey" Description="Tags items that sign in with a passkey">
                                <hoobi:SettingsCard.Preview>
                                    <Border Classes="Badge"><TextBlock Text="Passkey" /></Border>
                                </hoobi:SettingsCard.Preview>
                                <ToggleSwitch IsChecked="True" OnContent="{x:Null}" OffContent="{x:Null}" />
                            </hoobi:SettingsCard>
                        </StackPanel>
                    </hoobi:SettingsCard.ExpandedContent>
                </hoobi:SettingsCard>
            </StackPanel>
            <TextBlock Classes="GroupHeader" Text="SettingsCard.Highlighted" />
            <hoobi:SettingsCard Classes="Highlighted" Header="Lock after" Description="Locks the vault when the app is idle." HeaderGlyph="{StaticResource Glyph.Lock}">
                <ComboBox SelectedIndex="0" Width="160">
                    <ComboBoxItem Content="5 minutes" />
                    <ComboBoxItem Content="Never" />
                </ComboBox>
            </hoobi:SettingsCard>
            <TextBlock Classes="GroupHeader" Text="SettingsCard.FirstVisible.LastVisible" />
            <StackPanel Classes="SettingsGroup">
                <hoobi:SettingsCard Header="About" Description="Version 12.1.4" HeaderGlyph="{StaticResource Glyph.Info}" IsClickEnabled="True" ActionGlyph="{StaticResource Glyph.OpenInNewWindow}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
