<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>Hoobi</Authors>
    <Company>Hoobi</Company>
    <Product>Hoobi Design</Product>
    <Copyright>Copyright (c) Hoobi $([System.DateTime]::Now.Year)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RepositoryUrl>https://dev.azure.com/Hoobi/Hoobi/_git/hoobi-design</RepositoryUrl>
    <IsPackable>false</IsPackable>
    <Version Condition="'$(Version)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../react/package.json')), '"version":\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

</Project>
