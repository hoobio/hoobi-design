<Project>

  <PropertyGroup>
    <HoobiDesignOwnedKeys Condition="'$(HoobiDesignOwnedKeys)' == ''">$(MSBuildThisFileDirectory)Hoobi.Design.Avalonia.keys.txt</HoobiDesignOwnedKeys>
  </PropertyGroup>

  <UsingTask TaskName="HoobiDesignCheck" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OwnedKeys ParameterType="System.String" />
      <WriteKeys ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var xaml = XNamespace.Get("http://schemas.microsoft.com/winfx/2006/xaml");
var exempt = new Regex(@"<!--\s*hex-ok:\s*\S");
var hexLiteral = @"#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3,4})\b";
var hex = new Regex(@"^\s*" + hexLiteral + @"\s*$");
var shadowHex = new Regex(@"(?<![\w#])" + hexLiteral);
var named = new Regex(@"^\s*(?!(?i:Transparent|True|False)\s*$)[A-Za-z]+\s*$");
var colourProperty = new Regex(@"^(?:\w*Background|\w*Foreground|\w*Fill|\w*Stroke|\w*Color|\w+Brush)$");
var shadowProperty = new Regex(@"^BoxShadows?$");
var appScopeOwners = new HashSet<string>(StringComparer.Ordinal) { "Application", "Styles", "Style", "ControlTheme", "ResourceDictionary" };
var owned = WriteKeys == null && !string.IsNullOrEmpty(OwnedKeys) && File.Exists(OwnedKeys)
    ? new HashSet<string>(File.ReadAllLines(OwnedKeys), StringComparer.Ordinal)
    : new HashSet<string>(StringComparer.Ordinal);
var keys = new SortedSet<string>(StringComparer.Ordinal);
var popupExempt = new Regex(@"<!--\s*popup-ok:\s*\S");
var popupKeys = new HashSet<string>(StringComparer.Ordinal) { "FlyoutPresenterBackground", "MenuFlyoutPresenterBackground", "ComboBoxDropDownBackground" };
var popupTypes = new HashSet<string>(StringComparer.Ordinal) { "FlyoutPresenter", "MenuFlyoutPresenter", "ToolTip", "ContextMenu", "DatePickerPresenter", "TimePickerPresenter" };
var popupPart = new Regex(@"#(?:PopupBorder|PART_SuggestionsContainer|DropDownRoot)\b");
var selectorType = new Regex(@"^(?:\w+\|)?(\w+)");

bool PopupSelector(string selector) => selector.Split(',').Any(part =>
{
    var tokens = part.Replace("/template/", " ").Split(new[] { ' ', '>' }, StringSplitOptions.RemoveEmptyEntries);
    if (tokens.Length == 0)
    {
        return false;
    }

    var last = tokens[tokens.Length - 1];
    var type = selectorType.Match(last);
    return popupPart.IsMatch(last) || (type.Success && popupTypes.Contains(type.Groups[1].Value));
});

bool PopupTarget(XElement setter)
{
    for (var owner = setter.Parent; owner != null; owner = owner.Parent)
    {
        if (owner.Name.LocalName == "Style" && owner.Attribute("Selector") is { } selector)
        {
            if (!selector.Value.TrimStart().StartsWith("^", StringComparison.Ordinal))
            {
                return PopupSelector(selector.Value);
            }

            if (PopupSelector(selector.Value.Replace("^", "")))
            {
                return true;
            }
        }
        else if (owner.Name.LocalName == "ControlTheme")
        {
            var target = owner.Attribute("TargetType")?.Value ?? "";
            return popupTypes.Contains(target.Substring(target.IndexOf(':') + 1));
        }
    }

    return false;
}

bool AcrylicOff(string property, string value) =>
    property.EndsWith("Acrylic.IsEnabled", StringComparison.Ordinal) && string.Equals(value.Trim(), "False", StringComparison.OrdinalIgnoreCase);

string Literal(string property, string value)
{
    var name = property.Substring(property.LastIndexOf('.') + 1);
    if (shadowProperty.IsMatch(name))
    {
        var match = shadowHex.Match(value);
        return match.Success ? match.Value : null;
    }

    return colourProperty.IsMatch(name) && (hex.IsMatch(value) || named.IsMatch(value)) ? value.Trim() : null;
}

bool AppScoped(XElement element)
{
    for (var ancestor = element.Parent; ancestor != null; ancestor = ancestor.Parent)
    {
        var name = ancestor.Name.LocalName;
        var dot = name.IndexOf('.');
        if (dot > 0 && (name.EndsWith(".Resources", StringComparison.Ordinal) || name.EndsWith(".Styles", StringComparison.Ordinal)) && !appScopeOwners.Contains(name.Substring(0, dot)))
        {
            return false;
        }
    }

    return true;
}

foreach (var item in Files)
{
    var path = item.GetMetadata("FullPath");
    var lines = File.ReadAllLines(path);
    XDocument document;
    try
    {
        document = XDocument.Load(path, LoadOptions.SetLineInfo);
    }
    // The Avalonia XAML compiler reports a malformed file with its own position.
    catch (XmlException)
    {
        continue;
    }

    void Report(IXmlLineInfo at, string literal)
    {
        var line = at.LineNumber;
        if (literal != null && !(line > 1 && exempt.IsMatch(lines[line - 2])))
        {
            Log.LogError(null, "HOOBI001", null, path, line, at.LinePosition, 0, 0, "Literal colour \"{0}\": use a Hoobi token resource, or put <!-- hex-ok: reason --> on the line above.", literal);
        }
    }

    void ReportPopup(IXmlLineInfo at, string what)
    {
        var line = at.LineNumber;
        if (!(line > 1 && popupExempt.IsMatch(lines[line - 2])))
        {
            Log.LogError(null, "HOOBI003", null, path, line, at.LinePosition, 0, 0, "{0}: every popup surface takes the Mirage acrylic from Hoobi.Design.Avalonia; change the design system, or put <!-- popup-ok: reason --> on the line above.", what);
        }
    }

    foreach (var element in document.Descendants())
    {
        var key = element.Attribute(xaml + "Key");
        if (key != null && !(element.Name.LocalName == "ResourceDictionary" && element.Parent?.Name.LocalName == "ResourceDictionary.ThemeDictionaries"))
        {
            keys.Add(key.Value);
            if (owned.Contains(key.Value) && AppScoped(element))
            {
                IXmlLineInfo at = key;
                Log.LogError(null, "HOOBI002", null, path, at.LineNumber, at.LinePosition, 0, 0, "x:Key \"{0}\" is defined by Hoobi.Design.Avalonia at app scope; change the design system, or scope the override to the element's own Resources.", key.Value);
            }
        }

        if (WriteKeys != null)
        {
            continue;
        }

        if (key != null && (popupKeys.Contains(key.Value) || key.Value.StartsWith("HoobiFlyoutAcrylic", StringComparison.Ordinal)))
        {
            ReportPopup(key, "x:Key \"" + key.Value + "\" redefines a popup surface resource");
        }

        foreach (var attribute in element.Attributes().Where(attribute => AcrylicOff(attribute.Name.LocalName, attribute.Value)))
        {
            ReportPopup(attribute, "Acrylic.IsEnabled=\"False\"");
        }

        if (popupTypes.Contains(element.Name.LocalName) && element.Attribute("Background") is { } background)
        {
            ReportPopup(background, element.Name.LocalName + " Background");
        }

        if (element.Name.LocalName == "Setter" && element.Attribute("Property") is { } popupProperty)
        {
            var popupValue = element.Attribute("Value")?.Value ?? "";
            if (AcrylicOff(popupProperty.Value, popupValue))
            {
                ReportPopup(popupProperty, "Acrylic.IsEnabled set to False");
            }
            else if (popupProperty.Value == "Background" && PopupTarget(element))
            {
                ReportPopup(popupProperty, "Background on a popup surface");
            }
        }

        foreach (var attribute in element.Attributes().Where(attribute => attribute.Name.Namespace == XNamespace.None))
        {
            Report(attribute, Literal(attribute.Name.LocalName, attribute.Value));
        }

        if (element.Name.LocalName == "Setter" && element.Attribute("Property") is { } property && element.Attribute("Value") is { } value)
        {
            Report(value, Literal(property.Value, value.Value));
        }

        var content = element.Name.LocalName == "SolidColorBrush" ? "Color" : element.Name.LocalName;
        if (!element.HasElements && element.Nodes().OfType<XText>().FirstOrDefault() is { } text)
        {
            Report(text, Literal(content, text.Value));
        }
    }
}

if (WriteKeys != null)
{
    Directory.CreateDirectory(Path.GetDirectoryName(WriteKeys));
    File.WriteAllLines(WriteKeys, keys);
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="HoobiDesignCheck" BeforeTargets="CoreCompile" Condition="'$(HoobiDesignChecks)' != 'false'">
    <ItemGroup>
      <_HoobiDesignAxaml Include="@(AvaloniaXaml)" Exclude="@(HoobiDesignChecksExclude)" />
    </ItemGroup>
    <HoobiDesignCheck Files="@(_HoobiDesignAxaml)" OwnedKeys="$(HoobiDesignOwnedKeys)" Condition="'@(_HoobiDesignAxaml)' != ''" />
  </Target>

</Project>
