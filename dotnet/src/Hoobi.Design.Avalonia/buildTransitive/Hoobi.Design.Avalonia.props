<Project>

  <ItemGroup Condition="'$(HoobiDesignGcDefaults)' != 'false'">
    <RuntimeHostConfigurationOption Include="System.GC.Concurrent" Value="false" Condition="'$(ConcurrentGarbageCollection)' == ''" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- Without a cap the gen0 budget is sized from the L3 cache. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="8388608" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\licenses\fonts\*.txt" Link="licenses\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
