<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hoobi="using:Hoobi.Design.Avalonia">
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type hoobi:SettingsCard}" TargetType="hoobi:SettingsCard">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoobiSettingsCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="MinHeight" Value="68" />
            <!-- Avalonia rounds a half pixel to even where WinUI rounds up, so 15 at 150% would lose a pixel. -->
            <Setter Property="Padding" Value="16,15.01" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                        <Border
                            x:Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Panel x:Name="PART_Icon" Grid.Column="0" Width="20" Height="20" Margin="2,0,20,0" VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding HeaderIcon}" />
                                    <TextBlock
                                        Classes="Glyph"
                                        FontSize="20"
                                        Text="{TemplateBinding HeaderGlyph}"
                                        IsVisible="{TemplateBinding HeaderGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Panel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="PART_Header" Content="{TemplateBinding Header}">
                                        <ContentPresenter.DataTemplates>
                                            <DataTemplate DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="{StaticResource ControlContentThemeFontSize}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ContentPresenter.DataTemplates>
                                    </ContentPresenter>
                                    <ContentPresenter
                                        x:Name="PART_Description"
                                        Content="{TemplateBinding Description}"
                                        TextElement.FontSize="{StaticResource CaptionTextBlockFontSize}"
                                        TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <ContentPresenter.DataTemplates>
                                            <DataTemplate DataType="x:String">
                                                <TextBlock Classes="Caption" Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ContentPresenter.DataTemplates>
                                    </ContentPresenter>
                                </StackPanel>
                                <ContentPresenter
                                    Grid.Column="2"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Classes="Glyph"
                                    Margin="14,0,0,0"
                                    FontSize="14"
                                    Text="{TemplateBinding ActionGlyph}"
                                    IsVisible="{TemplateBinding ActionGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^[IsClickEnabled=True]:pointerover /template/ Border#PART_Fill">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^[IsClickEnabled=True]:pressed /template/ Border#PART_Fill">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorTertiaryBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_Header">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_Description">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="StackPanel.SettingsGroup">
        <Setter Property="Spacing" Value="1" />
        <Setter Property="hoobi:GroupEdges.IsEnabled" Value="True" />
    </Style>
    <Style Selector="StackPanel.SettingsGroup > hoobi|SettingsCard">
        <Setter Property="CornerRadius" Value="{StaticResource HoobiGroupMiddleCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="StackPanel.SettingsGroup > hoobi|SettingsCard.FirstVisible">
        <Setter Property="CornerRadius" Value="{StaticResource HoobiGroupTopCornerRadius}" />
    </Style>
    <Style Selector="StackPanel.SettingsGroup > hoobi|SettingsCard.LastVisible">
        <Setter Property="CornerRadius" Value="{StaticResource HoobiGroupBottomCornerRadius}" />
    </Style>
    <Style Selector="StackPanel.SettingsGroup > hoobi|SettingsCard.FirstVisible.LastVisible">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>
    <Style Selector="hoobi|SettingsCard ToggleSwitch">
        <Setter Property="Margin" Value="0,-1,-12,-1" />
    </Style>
</Styles>
