<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:hoobi="using:Hoobi.Design.Avalonia">
    <Styles.Resources>
        <ControlTheme x:Key="DefaultButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        </ControlTheme>

        <ControlTheme x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CriticalButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource HoobiCriticalButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource HoobiCriticalButtonForeground}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiCriticalButtonBackgroundPointerOver}" />
                <Setter Property="Foreground" Value="{DynamicResource HoobiCriticalButtonForeground}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiCriticalButtonBackgroundPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource HoobiCriticalButtonForeground}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CautionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource HoobiCautionButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource HoobiCautionButtonForeground}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiCautionButtonBackgroundPointerOver}" />
                <Setter Property="Foreground" Value="{DynamicResource HoobiCautionButtonForeground}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiCautionButtonBackgroundPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource HoobiCautionButtonForeground}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="MenuRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="Normal" />
        </ControlTheme>

        <ControlTheme x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="{StaticResource HoobiNavItemHeight}" />
            <Setter Property="MinHeight" Value="{StaticResource HoobiNavItemHeight}" />
            <Setter Property="Margin" Value="{StaticResource HoobiNavItemMargin}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border
                            Name="PART_Indicator"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsVisible="False"
                            Background="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
            </Style>
            <Style Selector="^.Selected">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
            </Style>
            <Style Selector="^.Selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedPointerOver}" />
            </Style>
            <Style Selector="^.Selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelectedPressed}" />
            </Style>
            <Style Selector="^.Selected /template/ Border#PART_Indicator">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="SliderFillButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="{DynamicResource HoobiBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Border Height="4" Margin="7,0" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                        <Track
                            Name="PART_Track"
                            Orientation="Horizontal"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{TemplateBinding Value, Mode=TwoWay}"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderFillButtonStyle}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SliderFillButtonStyle}" Background="Transparent" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb" Width="14" Height="14" Background="{DynamicResource HoobiAccentHoverBrush}">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border CornerRadius="{StaticResource ControlCornerRadius}" Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^ /template/ Thumb#thumb:pointerover">
                <Setter Property="Background" Value="{DynamicResource HoobiSliderThumbPointerOverBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ Thumb#thumb">
                <Setter Property="Background" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
            <Style Selector="^.OverMeter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="Transparent" />
            </Style>
            <Style Selector="^.Seek">
                <Setter Property="MinHeight" Value="18" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="FloatingPanelStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="{DynamicResource HoobiFloatingPanelBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource OverlayCornerRadius}" ClipToBounds="True">
                        <ScrollViewer Classes="NarrowScrollBand" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentPresenter Margin="4" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^.Acrylic">
                <Setter Property="Background" Value="{DynamicResource HoobiFloatingPanelAcrylicBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource HoobiClearButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiClearButtonBackground}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AddRowButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CaptionLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{DynamicResource HoobiClearButtonBackground}" />
            <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiClearButtonBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiClearButtonBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorTertiaryBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource HoobiClearButtonBackground}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="DialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Style Selector="^.accent /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
            </Style>
            <Style Selector="^.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
            </Style>
            <Style Selector="^.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="SegmentedItemTheme" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTransparentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="PART_Hover" Margin="1,3" Background="{DynamicResource SubtleFillColorTransparentBrush}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.167" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <Border
                            Name="PART_Pill"
                            Width="16"
                            Height="3"
                            CornerRadius="1.5"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Opacity="0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:nth-child(1) /template/ Border#PART_Hover">
                <Setter Property="Margin" Value="3,3,1,3" />
            </Style>
            <Style Selector="^:nth-last-child(1) /template/ Border#PART_Hover">
                <Setter Property="Margin" Value="1,3,3,3" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_Hover">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Hover">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_Hover">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                <Setter Property="RenderTransform" Value="none" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#PART_Pill">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:selected:pointerover /template/ Border#PART_Pill">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:selected:pressed /template/ Border#PART_Pill">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="SegmentedStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="{DynamicResource HoobiSegmentedTrackBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="AutoScrollToSelectedItem" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedItemTheme}" />
            <Setter Property="hoobi:SegmentedSelection.SelectsOnRelease" Value="True" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="CaptionButtonTheme" TargetType="Button" BasedOn="{StaticResource FluentDrawnCaptionButton}">
            <Setter Property="Width" Value="{StaticResource HoobiCaptionButtonWidth}" />
            <Style Selector="^.Close:pointerover /template/ Border">
                <Setter Property="Background" Value="{DynamicResource HoobiCaptionCloseBackgroundPointerOver}" />
            </Style>
            <Style Selector="^.Close:pressed /template/ Border">
                <Setter Property="Background" Value="{DynamicResource HoobiCaptionCloseBackgroundPressed}" />
            </Style>
            <Style Selector="^.Icon">
                <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style Selector="^.Icon /template/ Viewbox">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>
            <Style Selector="^.Danger">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style Selector="^.Danger /template/ ui|FAFontIcon#ButtonIcon, ^.Danger.inactive /template/ ui|FAFontIcon#ButtonIcon">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="HoobiWindowDecorations" TargetType="chrome:WindowDrawnDecorations" BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <chrome:WindowDrawnDecorationsContent>
                        <chrome:WindowDrawnDecorationsContent.Underlay>
                            <Panel Name="PART_UnderlayWrapper">
                                <Border
                                    Name="PART_WindowBorder"
                                    Background="Transparent"
                                    BorderThickness="{TemplateBinding FrameThickness}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False" />
                                <Panel
                                    Name="PART_TitleBar"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="Transparent"
                                    IsVisible="{TemplateBinding HasTitleBar}"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Underlay>
                        <chrome:WindowDrawnDecorationsContent.Overlay>
                            <Panel Name="PART_OverlayWrapper">
                                <StackPanel
                                    Name="PART_OverlayPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    IsVisible="{TemplateBinding HasTitleBar}">
                                    <Button
                                        Name="PART_MinimizeButton"
                                        Classes="CaptionButton"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        Content="&#xE738;"
                                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton" />
                                    <Button
                                        Name="PART_MaximizeButton"
                                        Classes="CaptionButton"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        Content="&#xE739;"
                                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton" />
                                    <Button
                                        Name="PART_CloseButton"
                                        Classes="CaptionButton Close"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        FontSize="16"
                                        Content="&#xE711;"
                                        chrome:WindowDecorationProperties.ElementRole="CloseButton" />
                                </StackPanel>
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Overlay>
                    </chrome:WindowDrawnDecorationsContent>
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="HoobiCloseOnlyDecorations" TargetType="chrome:WindowDrawnDecorations" BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <chrome:WindowDrawnDecorationsContent>
                        <chrome:WindowDrawnDecorationsContent.Underlay>
                            <Panel Name="PART_UnderlayWrapper">
                                <Border
                                    Name="PART_WindowBorder"
                                    Background="Transparent"
                                    BorderThickness="{TemplateBinding FrameThickness}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False" />
                                <Panel
                                    Name="PART_TitleBar"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="Transparent"
                                    IsVisible="{TemplateBinding HasTitleBar}"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Underlay>
                        <chrome:WindowDrawnDecorationsContent.Overlay>
                            <Panel Name="PART_OverlayWrapper">
                                <StackPanel
                                    Name="PART_OverlayPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    IsVisible="{TemplateBinding HasTitleBar}">
                                    <Button
                                        Name="PART_CloseButton"
                                        Classes="CaptionButton Close"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        FontSize="16"
                                        Content="&#xE711;"
                                        chrome:WindowDecorationProperties.ElementRole="CloseButton" />
                                </StackPanel>
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Overlay>
                    </chrome:WindowDrawnDecorationsContent>
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource DefaultTextForegroundThemeBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource MenuFlyoutPresenterThemePadding}" />
            <Setter Property="MaxWidth" Value="{DynamicResource FlyoutThemeMaxWidth}" />
            <Setter Property="MinHeight" Value="{DynamicResource MenuFlyoutThemeMinHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
            <Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
            <Setter Property="WindowManagerAddShadowHint" Value="False" />
            <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{DynamicResource FlyoutBorderThemePadding}">
                        <ScrollViewer Margin="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue" Grid.IsSharedSizeScope="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector=":is(TopLevel)">
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextForegroundThemeBrush}" />
    </Style>

    <Style Selector="RadioButton, CheckBox, ToggleSwitch, ToggleButton, ComboBox, MenuItem">
        <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
    </Style>
    <Style Selector="Button.RowOverlay">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.Small">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Button.DropDown">
        <Setter Property="Background" Value="{DynamicResource HoobiChipBrush}" />
    </Style>
    <Style Selector="Button.DropDown:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
    </Style>
    <Style Selector="Button.DropDown:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoobiChipBrush}" />
    </Style>
    <Style Selector="Button.Fill">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.Fill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.Fill:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.ColumnHeader">
        <Setter Property="Theme" Value="{StaticResource SubtleButtonStyle}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="-4,0,0,0" />
    </Style>
    <Style Selector="Button.ColumnHeader TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ColumnHeader TextBlock.Glyph">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.Round">
        <Setter Property="Theme" Value="{StaticResource SubtleButtonStyle}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Round.Accent">
        <Setter Property="Theme" Value="{StaticResource AccentButtonStyle}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="Button.Round.Compact">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.Round.Accent.Compact">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
    </Style>
    <Style Selector="Button.Row">
        <Setter Property="Theme" Value="{StaticResource DefaultButtonStyle}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource HoobiChipBrush}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.Tile">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.Tile.XLarge">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
    </Style>
    <Style Selector="Button.Tile /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Swatch /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="ToggleButton.GlyphPick">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="ToggleButton.Swatch">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleButton.Swatch:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Swatch:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HoobiClearTextBrush}" />
    </Style>
    <Style Selector="ToggleButton.Swatch:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource HoobiTextBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="hoobi:SmoothScroll.IsEnabled" Value="True" />
        <Setter Property="hoobi:AutoScroll.IsEnabled" Value="True" />
    </Style>
    <Style Selector="ScrollViewer /template/ ScrollBar">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollViewer.ScrollActive /template/ ScrollBar, ScrollViewer /template/ ScrollBar:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="Margin" Value="1.75,0,-1.75,0" />
    </Style>

    <Style Selector="Button.CaptionButton">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- FluentAvalonia's pointerover replaces a local fill with the neutral hover brush, so a coloured button shades its own fill instead. -->
    <Style Selector="Button.Tinted:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Tinted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[TemplatedControl].Background, Converter={x:Static hoobi:ColorShade.Hover}}" />
        <Setter Property="Foreground" Value="{Binding $parent[TemplatedControl].Foreground}" />
    </Style>
    <Style Selector="Button.Tinted:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Tinted:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[TemplatedControl].Background, Converter={x:Static hoobi:ColorShade.Pressed}}" />
        <Setter Property="Foreground" Value="{Binding $parent[TemplatedControl].Foreground}" />
    </Style>

    <Style Selector="ToggleButton.Disclosure">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.Disclosure:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.Disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.Disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.Disclosure:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
    </Style>

    <Style Selector="HyperlinkButton /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.083" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch:not(:pointerover) /template/ Border#OuterBorder, ToggleSwitch:checked /template/ Border#OuterBorder, ToggleSwitch:not(:disabled) /template/ Border#SwitchKnobBounds">
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch:pointerover:unchecked /template/ Border#OuterBorder, ToggleSwitch:pressed:unchecked /template/ Border#OuterBorder">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.083" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="HyperlinkButton /template/ ContentPresenter > TextBlock:not(.Underlined)">
        <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>

    <Style Selector="Path.CloseGlyph">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Data" Value="M1.5,1.5 L11.5,11.5 M11.5,1.5 L1.5,11.5" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Square" />
        <Setter Property="Stroke" Value="{Binding $self.(TextElement.Foreground)}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox:checked /template/ ui|FAFontIcon#CheckGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Child">
            <Template>
                <Path
                    Classes="CheckTick"
                    Data="M4.2,9.2 L7.5,12.5 L13.8,6.2"
                    StrokeThickness="1.3"
                    StrokeJoin="Miter" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="CheckBox Path.CheckTick">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" />
    </Style>
    <Style Selector="CheckBox:checked Path.CheckTick">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover Path.CheckTick">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPointerOver}" />
    </Style>
    <Style Selector="CheckBox:checked:pressed Path.CheckTick">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedPressed}" />
    </Style>
    <Style Selector="CheckBox:checked:disabled Path.CheckTick">
        <Setter Property="Stroke" Value="{DynamicResource CheckBoxCheckGlyphForegroundCheckedDisabled}" />
    </Style>

    <Style Selector="RadioButton:pressed /template/ Ellipse#CheckGlyph">
        <Setter Property="RenderTransform" Value="scale(0.8333)" />
    </Style>

    <Style Selector=":is(TextBlock)">
        <Setter Property="LineHeight">
            <MultiBinding Converter="{x:Static hoobi:SegoeMetrics.LineHeightConverter}">
                <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                <Binding Path="FontFamily" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
        <Setter Property="hoobi:SegoeMetrics.IsEnabled" Value="True" />
    </Style>
    <Style Selector="StackPanel[Orientation=Vertical] > :is(TextBlock), StackPanel[Orientation=Vertical] > Grid > :is(TextBlock), StackPanel[Orientation=Vertical] > ContentPresenter > :is(TextBlock)">
        <Setter Property="hoobi:SegoeMetrics.IsFree" Value="True" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="LineHeight">
            <MultiBinding Converter="{x:Static hoobi:SegoeMetrics.LineHeightConverter}">
                <Binding Path="FontSize" RelativeSource="{RelativeSource Self}" />
                <Binding Path="FontFamily" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
    </Style>
    <Style Selector="TextBox.Multiline">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox.Invalid /template/ Border#PART_BorderElement, TextBox.Invalid:pointerover /template/ Border#PART_BorderElement, TextBox.Invalid:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource HoobiCriticalTintBrush}" />
    </Style>
    <Style Selector="TextBox.revealPasswordButton">
        <Setter Property="hoobi:HoldToReveal.IsEnabled" Value="True" />
    </Style>
    <Style Selector="TextBox.revealPasswordButton ToggleButton">
        <Setter Property="Width" Value="36" />
    </Style>
    <Style Selector="TextBox.revealPasswordButton ToggleButton /template/ ui|FAFontIcon#Glyph">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="Glyph" Value="{StaticResource Glyph.Eye}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TextBox.revealPasswordButton ToggleButton:checked /template/ ui|FAFontIcon#Glyph">
        <Setter Property="Glyph" Value="{StaticResource Glyph.EyeOff}" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,6,0,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox /template/ ContentPresenter#ContentPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The template sets the glyph, which outranks a style without a pseudo-class, so this pair matches every state. -->
    <Style Selector="ComboBox:not(:disabled) /template/ ui|FAFontIcon#DropDownGlyph, ComboBox:disabled /template/ ui|FAFontIcon#DropDownGlyph">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="Glyph" Value="{StaticResource Glyph.ChevronDown}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="ComboBox.Invalid /template/ Border#Background, ComboBox.Invalid:pointerover /template/ Border#Background, ComboBox.Invalid:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource HoobiCriticalTintBrush}" />
    </Style>
    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="BoxShadow" Value="{StaticResource HoobiFlyoutShadow}" />
    </Style>
    <Style Selector="ComboBox /template/ Popup#PART_Popup">
        <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
        <Setter Property="VerticalOffset" Value="4" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="Padding" Value="11,7,11,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>
    <Style Selector="ComboBoxItem /template/ Rectangle#Pill">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="Padding" Value="9,7,9,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
    </Style>
    <Style Selector="ToggleSwitch /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="IsVisible" Value="{Binding $parent[ToggleSwitch].Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
    </Style>
    <Style Selector="Slider[Orientation=Horizontal]">
        <Setter Property="Theme" Value="{StaticResource SliderStyle}" />
    </Style>
    <Style Selector="CheckBox, RadioButton">
        <Setter Property="Padding" Value="8,7,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="ui|FAInfoBar[IsOpen=True] /template/ uip|FAInfoBarPanel">
        <Setter Property="VerticalOrientationPadding" Value="0,15,0,17" />
    </Style>
    <Style Selector="ui|FAInfoBar[IsOpen=True] /template/ TextBlock#Title">
        <Setter Property="uip:FAInfoBarPanel.HorizontalOrientationMargin" Value="0,15,0,0" />
    </Style>
    <Style Selector="ui|FAInfoBar[IsOpen=True] /template/ TextBlock#Message">
        <Setter Property="uip:FAInfoBarPanel.HorizontalOrientationMargin" Value="12,15,0,0" />
    </Style>
    <Style Selector="TextPresenter">
        <Setter Property="hoobi:SegoeMetrics.IsEnabled" Value="True" />
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.Body">
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.BodyStrong">
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.FieldHeader">
        <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlHeaderForeground}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.FieldHeader.ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource ComboBoxHeaderForeground}" />
    </Style>
    <Style Selector="TextBlock.Glyph">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Icon">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Icon.Accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.GroupHeader">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="4,20,4,8" />
    </Style>
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.Row.Edit TextBlock.FieldLabel">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.Warn">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="TextBlock.Dim">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.Mute">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontFamily" Value="{StaticResource HoobiDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource HoobiPageTitleMargin}" />
    </Style>
    <Style Selector="TextBlock.EmptyState">
        <Setter Property="Margin" Value="0,24" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.NavGlyph">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="40" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Chevron">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Text" Value="{StaticResource Glyph.ChevronDown}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="{StaticResource HoobiEaseStandard}" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.Chevron.Expanded, Button.DropDown:flyout-open TextBlock.Chevron, ToggleButton.Chevron:checked TextBlock.Chevron">
        <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="TextBlock.DragHandle">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="Text" Value="{StaticResource Glyph.ReOrder}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeAll" />
    </Style>
    <Style Selector="TextBlock.DragHandle:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox.Code">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="{StaticResource HoobiMonoFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LetterSpacing" Value="2.04" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.Code:not(:disabled) /template/ Border#PART_BorderElement, TextBox.Code:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBox.Code:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="BorderBrush" Value="{DynamicResource HoobiAccentBrush}" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource FlyoutPresenterBackground}" />
        <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ Border#PART_SuggestionsContainer, CalendarDatePicker /template/ Border#DropDownRoot">
        <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>
    <Style Selector="DatePicker:not(:disabled) /template/ TextBlock, DatePicker:disabled /template/ TextBlock, TimePicker:not(:disabled) /template/ TextBlock, TimePicker:disabled /template/ TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="DatePickerPresenter, TimePickerPresenter">
        <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>
    <Style Selector="CalendarDatePicker:not(:disabled) /template/ Calendar#PART_Calendar, CalendarDatePicker:disabled /template/ Calendar#PART_Calendar">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="FlyoutPresenter.Flush">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="MenuFlyoutPresenter, FlyoutPresenter.Below">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="RenderTransform" Value="translateY(4px)" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
        <Setter Property="hoobi:Acrylic.IsEnabled" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextForegroundThemeBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11,4" />
    </Style>
    <Style Selector="MenuItem:not(:disabled) /template/ Border#PART_LayoutRoot, MenuItem:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="MenuItem:not(:disabled) /template/ Viewbox#PART_IconPresenter, MenuItem:disabled /template/ Viewbox#PART_IconPresenter">
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="MenuItem:checked:toggle /template/ ContentControl#PART_ToggleIconPresenter">
        <Setter Property="Grid.Column" Value="4" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Content">
            <Template>
                <TextBlock Classes="Glyph" Text="{StaticResource Glyph.CheckMark}" FontSize="16" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="IsVisible" Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Style>
    <Style Selector="MenuItem:selected:not(:pointerover):not(:focus-visible) /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutItemBackground}" />
    </Style>
    <Style Selector="MenuItem.Danger">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="MenuItem.Danger:not(:disabled) /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="ButtonSpinnerLocation" Value="Right" />
    </Style>
    <Style Selector="NumericUpDown /template/ TextBox">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    </Style>
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ StackPanel#PART_SpinnerPanel">
        <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="NumericUpDown:not(:disabled) /template/ ButtonSpinner /template/ RepeatButton, NumericUpDown:disabled /template/ ButtonSpinner /template/ RepeatButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="NumericUpDown:not(:disabled) /template/ ButtonSpinner /template/ RepeatButton#PART_IncreaseButton, NumericUpDown:disabled /template/ ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Content" Value="{StaticResource Glyph.ChevronUp}" />
    </Style>
    <Style Selector="NumericUpDown:not(:disabled) /template/ ButtonSpinner /template/ RepeatButton#PART_DecreaseButton, NumericUpDown:disabled /template/ ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Content" Value="{StaticResource Glyph.ChevronDown}" />
    </Style>

    <Style Selector="TabStripItem">
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="MinHeight" Value="32" />
        <!-- The 19px label centres on a half pixel that rounds up, one pixel above the ink centre. -->
        <Setter Property="Padding" Value="4,1,4,0" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TabStripItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="hoobi|ProgressRing">
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ui|FAInfoBar">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.Group">
        <Setter Property="Background" Value="{DynamicResource HoobiBgBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="StackPanel.Rows">
        <Setter Property="Spacing" Value="1" />
    </Style>
    <Style Selector="ItemsControl.Rows">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="StackPanel.Rows > ItemsControl.Rows:empty">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.Row">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.5" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Row.Highlighted, Border.Group.Highlighted Border.Row">
        <Setter Property="Background" Value="{DynamicResource HoobiHighlightBrush}" />
    </Style>
    <Style Selector="Border.Row.Field">
        <Setter Property="Padding" Value="{StaticResource HoobiCardRowPadding}" />
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.Row.Switch">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="Border.Row.Switch.Child">
        <Setter Property="Padding" Value="40,8,16,8" />
    </Style>
    <Style Selector="Border.Row.Switch ToggleSwitch">
        <!-- A boxed 14px label in this row centres its capitals one pixel above the knob track, so the switch rises one pixel to meet them. -->
        <Setter Property="Margin" Value="0,-1,-12,1" />
    </Style>
    <Style Selector="Border.Row.KeyValue">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="37" />
    </Style>
    <Style Selector="Border.Row.Hairline">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="{StaticResource HoobiCardRowMinHeight}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource HoobiBgBrush}" />
    </Style>
    <Style Selector="Border.Row TextBox, Border.Row NumericUpDown, Border.Row ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.Tile">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
    </Style>
    <Style Selector="Border.Tile.Large">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.Tile.Small">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.Avatar">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}" />
        <Setter Property="TextElement.FontSize" Value="16" />
    </Style>
    <Style Selector="Border.Avatar.Small">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="TextElement.FontSize" Value="10" />
    </Style>
    <Style Selector="Border.Inset">
        <Setter Property="Background" Value="{DynamicResource HoobiChipBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.Slot">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource HoobiBgBrush}" />
        <Setter Property="Margin" Value="{DynamicResource HoobiDividerBleed}" />
    </Style>
    <Style Selector="ContentPresenter.Lifted > Border">
        <Setter Property="BoxShadow" Value="{StaticResource HoobiFlyoutShadow}" />
        <Setter Property="Opacity" Value="0.95" />
    </Style>
    <Style Selector="ProgressBar.Thin">
        <Setter Property="Height" Value="3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="Background" Value="{DynamicResource HoobiChipBrush}" />
    </Style>
    <Style Selector="Border.Badge">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.Badge.Accent">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.Badge.Solid">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Border.Dot">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Border.Dot > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.KeyCap">
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="CornerRadius" Value="{StaticResource HoobiRadiusChip}" />
        <Setter Property="Background" Value="{DynamicResource HoobiChipBrush}" />
    </Style>
    <Style Selector="Border.KeyCap > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ItemsControl.KeyCaps">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="x:String">
                <Border Classes="KeyCap">
                    <TextBlock Text="{Binding}" />
                </Border>
            </DataTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBlock.BadgeIcon">
        <Setter Property="FontFamily" Value="{StaticResource HoobiIconFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Alert">
        <Setter Property="Background" Value="{DynamicResource HoobiCautionTintBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Border.Alert.Danger">
        <Setter Property="Background" Value="{DynamicResource HoobiCriticalTintBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.Alert.Success">
        <Setter Property="Background" Value="{DynamicResource HoobiSuccessTintBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="Border.Alert.Info">
        <Setter Property="Background" Value="{DynamicResource HoobiInfoTintBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
    </Style>
    <Style Selector="Panel.Ring">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Panel.Ring Arc">
        <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Panel.Ring TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Panel.Ring.Warn Arc">
        <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Panel.Ring.Warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
</Styles>
