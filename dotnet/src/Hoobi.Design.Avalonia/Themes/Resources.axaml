    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource HoobiSurfaceColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorTertiaryBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource HoobiSurfaceColor}" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource HoobiSurfaceColor}" />
    <SolidColorBrush x:Key="ExpanderBackground" Color="{StaticResource HoobiSurfaceColor}" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource HoobiTextColor}" />
