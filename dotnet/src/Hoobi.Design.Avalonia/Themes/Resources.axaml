<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://Hoobi.Design.Avalonia/Assets/Fonts#Hanken Grotesk</FontFamily>
    <FontFamily x:Key="HoobiDisplayFontFamily">avares://Hoobi.Design.Avalonia/Assets/Fonts#Hanken Grotesk</FontFamily>
    <FontFamily x:Key="HoobiMonoFontFamily">avares://Hoobi.Design.Avalonia/Assets/Fonts#Cascadia Mono</FontFamily>

    <StaticResource x:Key="SystemAccentColor" ResourceKey="HoobiAccentColor" />
    <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="HoobiAccentHoverColor" />
    <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="HoobiAccentHoverColor" />
    <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="HoobiAccentHoverColor" />

    <StaticResource x:Key="SystemFillColorSuccess" ResourceKey="HoobiSuccessColor" />
    <StaticResource x:Key="SystemFillColorCaution" ResourceKey="HoobiWarnColor" />
    <StaticResource x:Key="SystemFillColorCritical" ResourceKey="HoobiDangerColor" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource HoobiSuccessColor}" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource HoobiWarnColor}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource HoobiDangerColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource HoobiInfoColor}" />
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#FF393D1B" />
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FF433519" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FF442726" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#08FFFFFF" />

    <RadialGradientBrush x:Key="HoobiGroundGlowTopLeft" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="120%" RadiusY="90%">
        <GradientStop Color="#1A409FFF" Offset="0.0" />
        <GradientStop Color="#00409FFF" Offset="0.58" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HoobiGroundGlowTopRight" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="80%">
        <GradientStop Color="#12D4BFFF" Offset="0.0" />
        <GradientStop Color="#00D4BFFF" Offset="0.62" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="HoobiSuccessTintBrush" Color="#26BAE67E" />
    <SolidColorBrush x:Key="HoobiCautionTintBrush" Color="#26FFD580" />
    <SolidColorBrush x:Key="HoobiInfoTintBrush" Color="#26409FFF" />
    <SolidColorBrush x:Key="HoobiCriticalTintBrush" Color="#26F28779" />
    <!-- The web's bg-accent/15 composited over bg: an opaque fill fades from surface without passing through a lighter frame. -->
    <SolidColorBrush x:Key="HoobiHighlightBrush" Color="#FF1E3047" />

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource HoobiBgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource HoobiBgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource HoobiSurfaceColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource HoobiSurfaceRaisedColor}" />
