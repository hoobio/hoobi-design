    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource HoobiBgColor}" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource HoobiSurfaceColor}" />
