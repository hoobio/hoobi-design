    <Thickness x:Key="HoobiPageTitleMargin">0,-2,0,0</Thickness>
    <Thickness x:Key="HoobiCardRowPadding">16,10</Thickness>
    <Thickness x:Key="SettingsExpanderItemPadding">58,8,44,8</Thickness>
    <x:Double x:Key="HoobiCardRowMinHeight">52</x:Double>
    <x:Double x:Key="HoobiNavItemHeight">36</x:Double>
    <Thickness x:Key="HoobiNavItemMargin">4,2</Thickness>
    <CornerRadius x:Key="HoobiGroupTopCornerRadius">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="HoobiGroupMiddleCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="HoobiGroupBottomCornerRadius">0,0,8,8</CornerRadius>
    <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    <Thickness x:Key="ContentDialogPadding">24</Thickness>
    <Thickness x:Key="ContentDialogTitleMargin">0,0,0,12</Thickness>
    <x:Double x:Key="CaptionTextBlockFontSize">12</x:Double>
    <x:Double x:Key="BodyTextBlockFontSize">14</x:Double>
    <x:Double x:Key="SubtitleTextBlockFontSize">20</x:Double>

    <SolidColorBrush x:Key="HoobiSettingsCardStrokeBrush" Color="{StaticResource HoobiFluentControlAltSecondaryColor}" />
    <SolidColorBrush x:Key="HoobiToastWindowBackground" Color="{StaticResource HoobiSurfaceRaisedClearColor}" />
    <SolidColorBrush x:Key="HoobiSettingsExpandedHeaderBrush" Color="{StaticResource HoobiSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="HoobiSliderThumbPointerOverBrush" Color="{StaticResource HoobiSliderThumbHoverColor}" />
    <SolidColorBrush x:Key="HoobiFloatingPanelBrush" Color="{StaticResource HoobiBgColor}" />
    <SolidColorBrush x:Key="HoobiFloatingPanelAcrylicBrush" Color="{StaticResource HoobiFloatingAcrylicColor}" />
    <Thickness x:Key="HoobiDividerBleed">-12,0</Thickness>
    <DropShadowEffect x:Key="HoobiDialogShadow" OffsetX="0" OffsetY="8" BlurRadius="32" Color="{StaticResource HoobiDialogShadowColor}" />
    <StaticResource x:Key="HoobiFlyoutShadow" ResourceKey="HoobiShadowFlyout" />

    <ResourceDictionary x:Key="HoobiDialogScopeResources">
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource HoobiAccentSecondaryColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource HoobiAccentTertiaryColor}" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource HoobiFluentTextOnAccentColor}" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource HoobiFluentTextOnAccentSecondaryColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{StaticResource HoobiFluentControlStrongStrokeDisabledColor}" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{StaticResource HoobiFluentTextOnAccentDisabledColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource HoobiFluentControlDisabledColor}" />
        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource HoobiFluentTextDisabledColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{StaticResource HoobiFluentControlAltSecondaryColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource HoobiFluentControlDisabledColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource HoobiFluentControlAltQuarternaryColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="{StaticResource HoobiFluentSubtleTransparentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource HoobiFluentControlStrongStrokeColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{StaticResource HoobiFluentControlStrongStrokeColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="{StaticResource HoobiFluentControlStrongStrokeDisabledColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="{StaticResource HoobiFluentControlStrongStrokeDisabledColor}" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="HoobiDialogResources">
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        <Thickness x:Key="TextControlThemePadding">10,5,6,5</Thickness>
        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource HoobiFluentSubtleSecondaryColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource HoobiFluentDividerStrokeColor}" />
        <LinearGradientBrush x:Key="TextControlBackgroundFocused" StartPoint="0,0" EndPoint="0,32">
            <GradientStop Offset="0" Color="{StaticResource HoobiFluentControlInputActiveColor}" />
            <GradientStop Offset="0.9375" Color="{StaticResource HoobiFluentControlInputActiveColor}" />
            <GradientStop Offset="0.9375" Color="{StaticResource HoobiAccentHoverColor}" />
            <GradientStop Offset="1" Color="{StaticResource HoobiAccentHoverColor}" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource HoobiFluentControlDisabledColor}" />
        <LinearGradientBrush x:Key="TextControlBorderBrush" StartPoint="0,0" EndPoint="0,32">
            <GradientStop Offset="0" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeStrongColor}" />
            <GradientStop Offset="1" Color="{StaticResource HoobiDialogFieldStrokeStrongColor}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TextControlBorderBrushPointerOver" StartPoint="0,0" EndPoint="0,32">
            <GradientStop Offset="0" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeStrongColor}" />
            <GradientStop Offset="1" Color="{StaticResource HoobiDialogFieldStrokeStrongColor}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TextControlBorderBrushFocused" StartPoint="0,0" EndPoint="0,32">
            <GradientStop Offset="0" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiAccentHoverColor}" />
            <GradientStop Offset="1" Color="{StaticResource HoobiAccentHoverColor}" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource HoobiFluentTextDisabledColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource HoobiFluentTextSecondaryColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource HoobiFluentTextSecondaryColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource HoobiFluentTextSecondaryColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource HoobiFluentTextDisabledColor}" />
        <Thickness x:Key="ComboBoxBorderThemeThickness">1</Thickness>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource HoobiFluentSubtleSecondaryColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource HoobiFluentDividerStrokeColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource HoobiFluentControlTertiaryColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource HoobiFluentControlDisabledColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource HoobiFluentSubtleSecondaryColor}" />
        <LinearGradientBrush x:Key="ComboBoxBorderBrush" StartPoint="0,0" EndPoint="0,32">
            <GradientStop Offset="0" Color="{StaticResource HoobiDialogComboStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogComboStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="1" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ComboBoxBorderBrushPointerOver" StartPoint="0,0" EndPoint="0,32">
            <GradientStop Offset="0" Color="{StaticResource HoobiDialogComboStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogComboStrokeColor}" />
            <GradientStop Offset="0.96875" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
            <GradientStop Offset="1" Color="{StaticResource HoobiDialogFieldStrokeColor}" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="{StaticResource HoobiFluentTextPrimaryColor}" />
    </ResourceDictionary>
</ResourceDictionary>
