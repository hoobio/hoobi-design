    <RadialGradientBrush x:Key="HoobiGroundGlowTopLeft" Center="0%,0%" GradientOrigin="0%,0%" RadiusX="120%" RadiusY="90%">
        <GradientStop Color="{StaticResource HoobiGlowAccentColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource HoobiGlowAccentClearColor}" Offset="0.58" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="HoobiGroundGlowTopRight" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="100%" RadiusY="80%">
        <GradientStop Color="{StaticResource HoobiGlowPurpleColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource HoobiGlowPurpleClearColor}" Offset="0.62" />
    </RadialGradientBrush>
